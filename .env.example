# 로컬 개발용 환경 변수 예시. 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다
# dev 프로필은 H2 인메모리를 쓰므로 비워 두면 기본값(sa / 빈 비밀번호)이 쓰인다 (docs/requirements.md D-00)
DB_USERNAME=
DB_PASSWORD=

# neon 프로필 (클라우드 PostgreSQL, D-01). Neon 콘솔의 Connect 화면에서 확인한다
# URL은 JDBC 형식: jdbc:postgresql://<호스트>/<DB이름>?sslmode=require
NEON_DB_URL=
NEON_DB_USERNAME=
NEON_DB_PASSWORD=
